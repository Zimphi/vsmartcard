<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cloud_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <Button android:id="@+id/cloud_diagnostics_back" style="@style/CloudSecondaryButton" android:text="@string/cloud_back"/>
        <TextView style="@style/CloudHeading" android:layout_marginTop="24dp" android:text="@string/cloud_diagnostics" android:textSize="24sp"/>
        <Button android:id="@+id/cloud_guided_test" style="@style/CloudSecondaryButton" android:layout_marginTop="16dp" android:text="@string/cloud_guided_test"/>
        <TextView style="@style/CloudHeading" android:layout_marginTop="24dp" android:text="@string/cloud_device_values"/>
        <TextView android:id="@+id/cloud_device_values" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="14sp" android:textColor="@color/cloud_ink"/>
        <TextView android:id="@+id/cloud_reader_capabilities" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="14sp" android:textColor="@color/cloud_muted"/>
        <TextView style="@style/CloudHeading" android:layout_marginTop="24dp" android:text="@string/cloud_antenna_title"/>
        <TextView android:id="@+id/cloud_antenna_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/cloud_antenna_unavailable" android:textSize="14sp" android:textColor="@color/cloud_muted"/>
        <com.vsmartcard.acardemulator.cloud.NfcAntennaView android:id="@+id/cloud_antenna_view" android:layout_width="match_parent" android:layout_height="190dp" android:layout_marginTop="8dp" android:contentDescription="@string/cloud_antenna_title"/>
        <TextView style="@style/CloudHeading" android:layout_marginTop="24dp" android:text="@string/cloud_quality_title"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/cloud_quality_explanation" android:textSize="14sp" android:textColor="@color/cloud_muted"/>
        <TextView android:id="@+id/cloud_quality_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="13sp" android:textColor="@color/cloud_muted"/>
        <ProgressBar android:id="@+id/cloud_quality_meter" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="12dp" android:max="100" android:progressTint="@color/cloud_green" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/cloud_quality_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="15sp" android:textColor="@color/cloud_ink"/>
        <com.vsmartcard.acardemulator.cloud.NfcQualityView android:id="@+id/cloud_quality_graph" android:layout_width="match_parent" android:layout_height="140dp" android:layout_marginTop="12dp"/>
        <TextView style="@style/CloudHeading" android:layout_marginTop="24dp" android:text="@string/cloud_gain_title"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/cloud_gain_explanation" android:textSize="14sp" android:textColor="@color/cloud_muted"/>
        <TextView android:id="@+id/cloud_gain_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="15sp" android:textColor="@color/cloud_ink"/>
        <com.vsmartcard.acardemulator.cloud.NfcGainView android:id="@+id/cloud_gain_graph" android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="12dp"/>
        <TextView style="@style/CloudHeading" android:layout_marginTop="24dp" android:text="@string/cloud_test_title"/>
        <Spinner android:id="@+id/cloud_test_kind" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/cloud_test_kind"/>
        <Button android:id="@+id/cloud_test_reader" style="@style/CloudSecondaryButton" android:text="@string/cloud_test_reader"/>
        <Button android:id="@+id/cloud_test_mac" style="@style/CloudSecondaryButton" android:layout_marginTop="8dp" android:text="@string/cloud_test_mac"/>
        <Button android:id="@+id/cloud_test_stop" style="@style/CloudSecondaryButton" android:layout_marginTop="8dp" android:text="@string/cloud_test_stop"/>
        <TextView android:id="@+id/cloud_test_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="15sp" android:textColor="@color/cloud_ink"/>
        <TextView style="@style/CloudHeading" android:layout_marginTop="24dp" android:text="@string/cloud_position_title"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/cloud_position_explanation" android:textSize="14sp" android:textColor="@color/cloud_muted"/>
        <TextView android:id="@+id/cloud_position_arrow" android:layout_width="match_parent" android:layout_height="80dp" android:gravity="center" android:text="●" android:textSize="54sp" android:textColor="@color/cloud_blue"/>
        <TextView android:id="@+id/cloud_position_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="@color/cloud_ink"/>
        <com.vsmartcard.acardemulator.cloud.NfcGainView android:id="@+id/cloud_position_gain_graph" android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="12dp" android:contentDescription="@string/cloud_gain_positions"/>
        <TextView android:id="@+id/cloud_position_gain_values" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/cloud_muted"/>
        <Button android:id="@+id/cloud_position_measure" style="@style/CloudSecondaryButton" android:layout_marginTop="12dp" android:text="@string/cloud_position_measure"/>
        <Button android:id="@+id/cloud_position_reset" style="@style/CloudSecondaryButton" android:layout_marginTop="8dp" android:text="@string/cloud_position_reset"/>
        <Button android:id="@+id/cloud_compatibility" style="@style/CloudSecondaryButton" android:layout_marginTop="16dp" android:text="@string/cloud_compatibility"/>
        <CheckBox android:id="@+id/cloud_developer_options" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="16dp" android:text="@string/cloud_developer_options" android:textColor="@color/cloud_ink" android:buttonTint="@color/cloud_blue"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cloud_developer_help" android:textColor="@color/cloud_muted" android:textSize="14sp"/>
        <LinearLayout android:id="@+id/cloud_log_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp" android:padding="16dp" android:background="@drawable/cloud_panel" android:visibility="gone">
            <TextView style="@style/CloudHeading" android:text="@string/cloud_log_title"/>
            <ScrollView android:id="@+id/cloud_log_scroll" android:layout_width="match_parent" android:layout_height="320dp" android:layout_marginTop="12dp" android:fillViewport="true">
                <TextView android:text="@string/cloud_log_empty" android:id="@+id/cloud_log_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:textSize="12sp" android:textColor="@color/cloud_ink" android:lineSpacingExtra="4dp"/>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
