<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cloud_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <Button android:id="@+id/cloud_help_back" style="@style/CloudSecondaryButton" android:text="@string/cloud_back"/>
        <TextView android:id="@+id/cloud_help_title" style="@style/CloudHeading" android:layout_marginTop="24dp" android:textSize="24sp"/>
        <TextView android:id="@+id/cloud_help_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="16sp" android:textColor="@color/cloud_ink"/>
        <Button android:id="@+id/cloud_help_action" style="@style/CloudSecondaryButton" android:layout_marginTop="16dp"/>
        <ImageView android:id="@+id/cloud_help_image" android:layout_width="match_parent" android:layout_height="wrap_content" android:adjustViewBounds="true" android:layout_marginTop="16dp" android:contentDescription="@string/cloud_help_image"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
            <Button android:id="@+id/cloud_help_previous" style="@style/CloudSecondaryButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/cloud_previous"/>
            <Button android:id="@+id/cloud_help_next" style="@style/CloudSecondaryButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/cloud_next"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
