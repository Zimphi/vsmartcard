    <string name="cloud_source_links">Quellcode dieses Forks:\nhttps://github.com/Zimphi/vsmartcard/tree/codex/phoenix-cloud\n\nUrsprüngliches Projekt:\nhttps://github.com/frankmorgner/vsmartcard</string>
